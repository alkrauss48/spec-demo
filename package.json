{
  "name": "photo-album-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "perf:lighthouse": "lhci autorun",
    "perf:upload": "PERF=1 playwright test tests/perf --project=chromium",
    "perf:bundle": "tsx scripts/check-bundle.ts",
    "test:log-privacy": "tsx scripts/check-log-privacy.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13.0.3",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "kysely": "^0.29.6",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.12.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
